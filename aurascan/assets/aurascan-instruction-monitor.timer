[Unit]
Description=Run AuraScan Agent Instruction Guard after login and every five minutes
Documentation=https://github.com/crizzler/AuraScan

[Timer]
OnStartupSec=1m
OnUnitActiveSec=5m
RandomizedDelaySec=30s
Persistent=true
Unit=aurascan-instruction-monitor.service

[Install]
WantedBy=timers.target
