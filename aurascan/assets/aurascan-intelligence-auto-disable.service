[Unit]
Description=Disable AuraScan daily signed-intelligence updates
Documentation=https://github.com/crizzler/AuraScan

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/env -i PATH=/usr/bin:/usr/sbin LANG=C LC_ALL=C HOME=/ /usr/bin/python -I -m aurascan.core.intelligence_cli _auto-disable
WorkingDirectory=/
UMask=0077
ReadWritePaths=/etc/systemd/system
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @privileged @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
IPAddressDeny=any
TimeoutStartSec=250
TimeoutStopSec=5
MemoryMax=128M
TasksMax=16
LimitFSIZE=1M
CPUQuota=25%
Restart=no
