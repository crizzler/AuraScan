[Unit]
Description=AuraScan Recovery boot-readiness marker
After=aurascan-recovery.service
Requires=aurascan-recovery.service
ConditionPathExists=/etc/aurascan/recovery-environment
ConditionVirtualization=vm

[Service]
Type=oneshot
ExecStart=/usr/bin/echo AURASCAN_RECOVERY_READY
StandardOutput=journal+console
StandardError=journal+console
SyslogIdentifier=aurascan-recovery-marker
DynamicUser=yes
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
KeyringMode=private
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateDevices=yes
PrivateIPC=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateUsers=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
