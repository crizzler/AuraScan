{
  "name": "aurascan-desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Read-only evidence console for AuraScan.",
  "main": "electron/main.cjs",
  "allowScripts": {
    "electron": true
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:dev": "npm run build && electron ."
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
