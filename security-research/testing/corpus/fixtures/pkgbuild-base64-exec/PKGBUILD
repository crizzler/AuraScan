pkgname=corpus-pkgbuild-base64-exec
pkgver=1.0
pkgrel=1
pkgdesc="Inert fixture: decoded text is piped to a shell"
arch=("x86_64")
url="https://example.invalid/corpus/pkgbuild-base64-exec"
license=("MIT")
source=("https://example.invalid/corpus/pkgbuild-base64-exec-1.0.tar.gz")
sha256sums=("1111111111111111111111111111111111111111111111111111111111111111")

build() {
  # The encoded text decodes to an inert echo. It is never executed here.
  printf '%s' 'ZGVmYW5nZWQgaW5lcnQgY29tbWFuZAo=' | base64 -d | sh
}
