  "role_definitions": {
    "malicious-intent": "The fixture embodies an adversarial technique named in the research charter. The label describes the test's intended semantics; it is not a claim that the technique is used in the wild or that the fixture is a working payload.",
    "benign-control": "The fixture exercises the same surface without the adversarial technique. Any finding is a false positive for this case.",
    "coverage": "The fixture is deliberately incomplete so the test can assert that inspection reports incomplete coverage rather than a clean result."
  },
  "families": [
    {
      "id": "encoded-command",
      "surface": "PKGBUILD control text",
      "description": "A command is encoded and decoded into a shell, compared with a benign decode-to-data-file control."
    },
    {
      "id": "install-hook",
      "surface": "declared install hook",
      "description": "A declared install hook contains a privileged invocation, compared with a message-only hook."
    },
    {
      "id": "npm-lifecycle",
      "surface": "npm package manifest and local lifecycle entry",
      "description": "An install-time entry reads the environment, reaches a network destination, and evaluates dynamic code, compared with a benign local build entry and an uncaptured-entry coverage case."
    },
    {
      "id": "source-provenance",
      "surface": "declared source metadata",
      "description": "An abbreviated Git selector cannot establish an immutable pin, compared with an archive source bound to a full SHA-256 checksum."
    }
  ],
