# Negative control: a daemon that owns files needs a system account. The
# account is locked, non-interactive, unprivileged, and never exposed over SSH,
# so AuraScan must not treat ordinary service-account packaging as a backdoor.
post_install() {
  /usr/bin/useradd --system --no-create-home --shell /usr/bin/nologin curated-fixture-daemon || true
  /usr/bin/passwd -l curated-fixture-daemon || true
}
